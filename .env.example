# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Business
BUSINESS_NAME=Camdis Hamburguesas
OWNER_PHONE=549XXXXXXXXXX
ADMIN_PHONES=549XXXXXXXXXX

# OpenAI
OPENAI_API_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_REQUIRE_WEBHOOK_SIGNATURE=true

# WhatsApp
ENABLE_WHATSAPP=false
WHATSAPP_AUTH_DIR=auth_info_baileys

# Database
DATABASE_PATH=data/database.sqlite

# Menu
MENU_PATH=data/menu.json

# Mercado Pago config
MERCADOPAGO_DRY_RUN=true
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_SUCCESS_URL=
MERCADOPAGO_FAILURE_URL=
MERCADOPAGO_PENDING_URL=

# Local notifications
LOCAL_NOTIFICATION_CHANNEL=INTERNAL
LOCAL_NOTIFICATION_DRY_RUN=true

# AI fallback
ENABLE_AI_FALLBACK=false
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_MS=15000

# Dev endpoints
DEV_ENDPOINT_TOKEN=

# Security / Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_BLOCK_MS=300000
MAX_MESSAGE_LENGTH=1000
ACTIVE_ORDER_TTL_HOURS=12
